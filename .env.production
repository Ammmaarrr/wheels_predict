# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Application
ENVIRONMENT=production
SECRET_KEY=pakwheels-super-secret-key-2025-production
DEBUG=false

# Database
DATABASE_URL=postgresql://pakwheels_user:secure_password123@db:5432/pakwheels_db
POSTGRES_DB=pakwheels_db
POSTGRES_USER=pakwheels_user
POSTGRES_PASSWORD=secure_password123

# Redis
REDIS_URL=redis://redis:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Frontend
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENVIRONMENT=production

# Monitoring
GRAFANA_PASSWORD=admin_password_2025

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Performance
WORKER_PROCESSES=4
MAX_CONNECTIONS=1000

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
