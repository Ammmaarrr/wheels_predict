# Example .env file for PakWheels Data Scraping and ML Project
# Copy this file to .env and fill in your real credentials

# Database Configuration (CRITICAL - Replace with real values)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pakwheelsdb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Security Configuration
SECRET_KEY=your_secret_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Redis Configuration (if used)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_if_needed

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your-email@gmail.com
SMTP_RECEIVER=your-service@yourdomain.com
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
PAKBOT_PASS=your-bot-password

# Model Configuration
MODEL_PATH=models/best_xgb_model_updated.joblib
TEST_MODE=False

# Feature Configuration
REQUIRED_FEATURES=year,mileage,engine_capacity,transmission,location
NUMERIC_FEATURES=year,mileage,engine_capacity
CATEGORICAL_FEATURES=transmission,location

# Recommendation Configuration
DEFAULT_NUM_RECOMMENDATIONS=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(name)s | %(levelname)s | %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Docker Configuration
FLASK_APP=web_interface.py
FLASK_ENV=development
JUPYTER_TOKEN=''  # Empty for no token, set a secure token in production
